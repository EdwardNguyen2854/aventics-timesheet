# IMPORTANT: Production must run on the internal server, behind HTTPS/restricted LAN/VPN.
# Use a local path on the server hosting this Node process. Do not use an SMB/UNC path for live SQLite files.
DATA_ROOT=./data
HOST=127.0.0.1
PORT=4177
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SESSION_SECURE=false
# Allow non-HTTPS cookies only for localhost development; set true behind HTTPS.
