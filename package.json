{
  "name": "aventics-worktrack",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @aventics/worktrack-api\" \"npm run dev -w @aventics/worktrack-web\"",
    "build": "npm run build -w @aventics/worktrack-web && npm run build -w @aventics/worktrack-api",
    "start": "npm run start -w @aventics/worktrack-api",
    "typecheck": "npm run typecheck -w @aventics/worktrack-web && npm run typecheck -w @aventics/worktrack-api",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=22"
  }
}